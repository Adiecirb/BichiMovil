<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextDisplay" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextHeading1" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextHeading2" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextTitle1" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextTitle2" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/gray_dark</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextBodySmall" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gray_medium</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextCaption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/gray_medium</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Botón Primario: fondo #220042, texto blanco -->
    <style name="ButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primaryColor</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Botón Secundario: blanco con borde #220042 -->
    <style name="ButtonSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/primaryColor</item>
        <item name="strokeColor">@color/primaryColor</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="backgroundTint">@color/white</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Botón Outline blanco (para fondos de color) -->
    <style name="ButtonOutlineWhite" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/white</item>
        <item name="strokeColor">@color/white</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Input OutlinedBox estándar -->
    <style name="TextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primaryColor</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/primaryColor</item>
        <item name="android:textColorHint">@color/gray_medium</item>
    </style>

    <!-- Input FilledBox sin fondo (línea solo abajo, para fondos de color) -->
    <style name="TextInputUnderline" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxStrokeColor">@color/white</item>
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="hintTextColor">@color/white</item>
        <item name="android:textColorHint">#AAAACC</item>
        <item name="endIconTint">@color/white</item>
        <item name="startIconTint">@color/white</item>
    </style>

    <style name="TextInputEditTextStyle" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="AppBarStyle" parent="Widget.MaterialComponents.AppBarLayout.Primary">
        <item name="backgroundTint">@color/primaryColor</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="BottomNavStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/primaryColor</item>
        <item name="itemTextColor">@color/white</item>
        <item name="itemIconTint">@color/white</item>
    </style>

    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardElevation">8dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <!-- Compatibilidad con código existente -->
    <style name="passwordTil" parent="TextInputLayoutStyle" />
    <style name="passwordTiet" parent="TextInputEditTextStyle" />
    <style name="signInLabel" parent="TextBody">
        <item name="android:textColor">@color/primaryColor</item>
    </style>
    <style name="signUpButton" parent="ButtonPrimary" />
    <style name="TextWhite" parent="TextBody">
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="TextHeading1White" parent="TextHeading1">
        <item name="android:textColor">@color/white</item>
    </style>

</resources>