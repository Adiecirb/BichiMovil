<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/circle_success_bg"
            android:gravity="center">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_dialog_info"
                android:tint="@color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Transacción exitosa"
            android:textColor="@color/primaryColor"
            android:textSize="20sp"
            android:fontFamily="@font/balgine_bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvMonto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="$0.00"
            android:textColor="@color/primaryColor"
            android:textSize="30sp"
            android:fontFamily="@font/balgine_bold"
            android:gravity="center" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/gray_light">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="DETALLES DE LA TRANSACCIÓN"
                    android:textColor="@color/primaryColor" android:textSize="11sp"
                    android:fontFamily="@font/balgine_bold" android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Código de confirmación"
                        android:textColor="@color/primaryColor" android:textSize="12sp" />
                    <TextView android:id="@+id/tvCodigo" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—"
                        android:textColor="@color/gray_dark" android:textSize="12sp"
                        android:fontFamily="@font/balgine_semibold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Fecha de operación"
                        android:textColor="@color/primaryColor" android:textSize="12sp" />
                    <TextView android:id="@+id/tvFecha" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—"
                        android:textColor="@color/gray_dark" android:textSize="12sp"
                        android:fontFamily="@font/balgine_semibold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Descripción"
                        android:textColor="@color/primaryColor" android:textSize="12sp" />
                    <TextView android:id="@+id/tvDescripcion" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—"
                        android:textColor="@color/gray_dark" android:textSize="12sp"
                        android:fontFamily="@font/balgine_semibold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Valor de la transacción"
                        android:textColor="@color/primaryColor" android:textSize="12sp" />
                    <TextView android:id="@+id/tvEstado" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Sin costo"
                        android:textColor="@color/success" android:textSize="12sp"
                        android:fontFamily="@font/balgine_semibold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            style="@style/ButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Volver al inicio"
            android:textAllCaps="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>