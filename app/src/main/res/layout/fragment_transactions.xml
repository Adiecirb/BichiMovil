<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header morado con tarjeta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primaryColor"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BichiMovil"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:fontFamily="@font/balgine_bold" />

                <ImageView
                    android:id="@+id/ivToggleBalance"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:tint="@color/white"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Tarjeta bancaria -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBancaria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="#3000E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BichiMovil"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:fontFamily="@font/balgine_bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CUENTA DIGITAL"
                                android:textColor="#CCCCFF"
                                android:textSize="10sp"
                                android:fontFamily="@font/balgine_regular" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/ic_lock_lock"
                            android:tint="@color/white" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Saldo actual"
                        android:textColor="#CCCCFF"
                        android:textSize="11sp"
                        android:fontFamily="@font/balgine_regular" />

                    <TextView
                        android:id="@+id/tvSaldo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="$0.00"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:fontFamily="@font/balgine_bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/tvCardDigits"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="**** 0000"
                            android:textColor="#CCCCFF"
                            android:textSize="13sp"
                            android:fontFamily="@font/balgine_regular" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMasDatos"
                            android:layout_width="128dp"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:backgroundTint="@android:color/transparent"
                            android:text="Más datos"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            app:cornerRadius="18dp"
                            app:strokeColor="@color/white"
                            app:strokeWidth="1dp"
                            app:icon="@null"
                            app:iconTint="@null" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Acciones rápidas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTransferirHome"
                    style="@style/ButtonPrimary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text=""
                    app:icon="@android:drawable/ic_menu_send"
                    app:iconTint="@color/white"
                    app:iconSize="22dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:cornerRadius="24dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Transferir"
                    android:textSize="10sp" android:textColor="@color/gray_dark"
                    android:fontFamily="@font/balgine_regular" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetirarHome"
                    style="@style/ButtonPrimary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text=""
                    app:icon="@android:drawable/ic_menu_save"
                    app:iconTint="@color/white"
                    app:iconSize="22dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:cornerRadius="24dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Retirar"
                    android:textSize="10sp" android:textColor="@color/gray_dark"
                    android:fontFamily="@font/balgine_regular" />
            </LinearLayout>


            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMasHome"
                    style="@style/ButtonPrimary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text=""
                    app:icon="@android:drawable/ic_menu_more"
                    app:iconTint="@color/white"
                    app:iconSize="22dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:cornerRadius="24dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Más"
                    android:textSize="10sp" android:textColor="@color/gray_dark"
                    android:fontFamily="@font/balgine_regular" />
            </LinearLayout>

        </LinearLayout>

        <!-- Últimos movimientos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="Últimos movimientos"
            android:textColor="@color/primaryColor"
            android:textSize="16sp"
            android:fontFamily="@font/balgine_bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/layoutEmptyTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sin movimientos recientes"
                android:textColor="@color/gray_medium"
                android:textSize="14sp"
                android:gravity="center"
                android:fontFamily="@font/balgine_regular" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>