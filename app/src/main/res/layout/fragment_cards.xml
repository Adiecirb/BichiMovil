<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primaryColor"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tarjetas"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:fontFamily="@font/balgine_bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTarjetas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/layoutEmptyCards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_dialog_dialer"
            android:tint="@color/gray_medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No tienes más tarjetas"
            android:textColor="@color/gray_dark"
            android:textSize="16sp"
            android:fontFamily="@font/balgine_semibold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="¡Solicita una nueva tarjeta y disfruta de más beneficios!"
            android:textColor="@color/gray_medium"
            android:textSize="13sp"
            android:fontFamily="@font/balgine_regular"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSolicitarTarjeta"
            style="@style/ButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="Solicitar tarjeta"
            android:textAllCaps="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvErrorTarjetas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center"
        android:textColor="@color/error"
        android:textSize="13sp"
        android:fontFamily="@font/balgine_regular"
        android:visibility="gone" />

</LinearLayout>